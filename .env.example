# SafeCheck — environment template.
# Copy to apps/api/.env and fill in. NEVER commit the real .env.
# Generate every secret below with:  openssl rand -hex 32

# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- database
# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/safecheck?retryWrites=true&w=majority"

# ---------------------------------------------------------------- redis (optional in dev)
# Leave blank to run BullMQ jobs inline in-process (no Redis needed for local dev).
# Set to a real Redis URL to exercise true queue behaviour.
REDIS_URL=

# ---------------------------------------------------------------- auth secrets
# 32+ bytes of hex each. Must differ from one another.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- privacy peppers
# IDENTIFIER_PEPPER hashes subject identifiers (phone/email) so the database holds
# no plaintext directory of reported people. Rotating it invalidates all subject
# lookups — treat it as permanent once data exists. Back it up separately.
IDENTIFIER_PEPPER=
# Encrypts evidence at rest (AES-256-GCM). Losing it makes evidence unrecoverable.
EVIDENCE_ENCRYPTION_KEY=

# ---------------------------------------------------------------- evidence storage
# local | s3 | cloudinary
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/evidence
# Only needed when STORAGE_DRIVER=s3 (works with AWS S3, Cloudflare R2, MinIO).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary. Used in two distinct roles:
#   • evidence  (STORAGE_DRIVER=cloudinary): bytes are AES-256-GCM encrypted first
#     and stored as PRIVATE `raw` assets — no public URL exists, retrieval is via
#     short-lived signed URLs only. Cloudinary sees ciphertext, never the image.
#   • avatars   (services/media.service.ts): ordinary public image uploads with
#     CDN delivery and EXIF stripped. Available whenever these creds are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_EVIDENCE_FOLDER=safecheck/evidence
CLOUDINARY_AVATAR_FOLDER=safecheck/avatars

# ---------------------------------------------------------------- email / sms
# console = print the OTP to stdout, no account needed, nothing leaves the
#           machine. Correct for local development, refused in production.
# smtp    = real delivery to a real inbox. Every provider below speaks SMTP, so
#           switching between them is a credential change, not a code change.
MAIL_DRIVER=console
MAIL_FROM="SafeCheck <no-reply@safecheck.local>"

# Either set SMTP_URL on its own, or the four discrete variables below it. The
# discrete form avoids percent-encoding: a password containing @ / : # in a URL
# fails as "authentication failed", which looks nothing like an encoding bug.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Free options that deliver to any address, pick one:
#
#   Brevo — 300 emails/day free forever, no card, no domain needed.
#   Sign up, then SMTP & API → SMTP. The "login" is an email, the key is not
#   your account password.
#     MAIL_DRIVER=smtp
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_USER=9xxxxx@smtp-brevo.com
#     SMTP_PASS=<the SMTP key>
#     MAIL_FROM="SafeCheck <you@yourgmail.com>"   # must be a verified sender
#
#   Gmail — ~500/day, free with any Google account. Needs 2-Step Verification
#   on, then myaccount.google.com/apppasswords for a 16-character app password
#   (your normal password will not work — Google blocks it for SMTP).
#     MAIL_DRIVER=smtp
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=465
#     SMTP_USER=you@gmail.com
#     SMTP_PASS=<16-char app password, spaces removed>
#     MAIL_FROM="SafeCheck <you@gmail.com>"       # must equal SMTP_USER
#
#   Resend — 3,000/month free, but until you verify a domain it will only
#   deliver to the address you signed up with. Fine for a solo test, not for
#   real users.
#     SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=re_...
#
#   Mailpit / Mailtrap — free and unlimited, but they capture mail instead of
#   delivering it. Use them to inspect the message, not to reach a user.
#     SMTP_HOST=localhost  SMTP_PORT=1025      # Mailpit, no auth

# console | twilio. There is no free tier for real SMS; a Twilio trial can only
# text numbers you have verified. Leave this on console unless you are paying.
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Must an account confirm its email before it can sign in?
# Leave unset and it follows the mail driver: required when a code can actually
# be delivered, skipped while MAIL_DRIVER=console — a confirmation step nobody
# can complete locks out every real user. Set true/false to decide explicitly.
REQUIRE_EMAIL_VERIFICATION=

# ---------------------------------------------------------------- policy windows
# Days a decision can be appealed before it may become searchable.
APPEAL_WINDOW_DAYS=14
# Days evidence is retained after a case closes, then purged by the retention job.
EVIDENCE_RETENTION_DAYS=365

# ---------------------------------------------------------------- pass 2 (unused for now)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
