# SafeCheck web — environment template.
# Copy to apps/web/.env.local. Nothing secret belongs in this file: anything
# prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is public.

# Where the Next.js dev server proxies /api/* to. Server-side only.
API_PROXY_TARGET=http://localhost:4000

# Leave BLANK to use the same-origin /api proxy (recommended — see next.config.ts).
# Set to an absolute API URL only if you want the browser to call the API
# directly; the API's WEB_ORIGIN must then match this app's origin exactly.
NEXT_PUBLIC_API_BASE_URL=
